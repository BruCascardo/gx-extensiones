    <Compile Include="..\SdtNode.cs" Link="SdtNode.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GX_PROGRAM_DIR)\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
