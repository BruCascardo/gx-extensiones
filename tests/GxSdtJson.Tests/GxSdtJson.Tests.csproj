<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas del formato JSON (SdtNode.cs de GxSdtJson), sin abrir GeneXus: dotnet run.
       GX_PROGRAM_DIR y la plataforma x86 vienen del Directory.Build.props de la raíz. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net471</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\GxSdtJson\SdtNode.cs" Link="SdtNode.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GX_PROGRAM_DIR)\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
