<?xml version="1.0" encoding="utf-8" ?>
<Package xmlns="http://schemas.genexus.com/addin/v1.0" id="3E8F6A42-9C1D-4B7E-A5F0-6D2C81B4E937" name="GxQuickVar">
  <Resources>
    <Resource type="strings" name="GxQuickVar.Messages" />
  </Resources>

  <!-- Sin atributo shortcut: los atajos son configurables (Tools > Options > GxQuickVar)
       y los maneja KeyBindingFilter. -->
  <Commands>
    <CommandDefinition id="GxQuickVarDeclare" context="selection" resourceId="CmdDeclare" />
    <CommandDefinition id="GxQuickVarDeclareAll" context="selection" resourceId="CmdDeclareAll" />
    <CommandDefinition id="GxQuickVarOptions" resourceId="CmdOptions" />
  </Commands>

  <Groups>
    <Group id="GxQuickVarEditGroup">
      <Command refid="GxQuickVarDeclare" />
      <Command refid="GxQuickVarDeclareAll" />
    </Group>
    <Group id="GxQuickVarToolsGroup">
      <Command refid="GxQuickVarOptions" />
    </Group>
  </Groups>

  <Menus>
    <Menu type="menubar">
      <Popup name="Edit" refid="EditMenu">
        <Group refid="GxQuickVarEditGroup" />
      </Popup>
      <Popup name="Tools" refid="ToolsMenu">
        <Group refid="GxQuickVarToolsGroup" />
      </Popup>
    </Menu>

    <!-- Menús contextuales del editor de texto (package TextEditor) -->
    <Menu type="context" id="TextEditorContext" package="E52B74A8-98E2-4a99-AE0E-547C72BD086D">
      <Group>
        <Command refid="GxQuickVarDeclare" />
        <Command refid="GxQuickVarDeclareAll" />
      </Group>
    </Menu>
    <Menu type="context" id="TextEditorSmartTagContext" package="E52B74A8-98E2-4a99-AE0E-547C72BD086D">
      <Group>
        <Command refid="GxQuickVarDeclare" />
      </Group>
    </Menu>
  </Menus>
</Package>
