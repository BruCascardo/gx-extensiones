<Project Sdk="GeneXus.Package.UI.Sdk">
  <PropertyGroup>
    <RootNamespace>GxCodeCheck</RootNamespace>
    <AssemblyName>GxCodeCheck</AssemblyName>
    <AssemblyTitle>GxCodeCheck</AssemblyTitle>
    <Description>Al guardar subraya en el código los errores de sintaxis y los de tipos y parámetros (con un chequeo rápido propio, que confirma la especificación), con una explicación clara y copiable al pasar el mouse</Description>
    <Version>1.0.21</Version>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>

  <!-- Estos ensamblados no están en el feed NuGet de GeneXus: se referencian desde la
       instalación local, sin copiarlos (los provee el IDE en runtime). -->
  <ItemGroup>
    <Reference Include="Artech.Genexus.UI.Common">
      <HintPath>$(GX_PROGRAM_DIR)\Artech.Genexus.UI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- La espera del Background Build (BackgroundBuildService.BACKGROUND_DELAY) -->
    <Reference Include="Artech.Packages.GenexusUI">
      <HintPath>$(GX_PROGRAM_DIR)\Packages\Artech.Packages.GenexusUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ActiproSoftware.SyntaxEditor.Net20">
      <HintPath>$(GX_PROGRAM_DIR)\ActiproSoftware.SyntaxEditor.Net20.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ActiproSoftware.WinUICore.Net20">
      <HintPath>$(GX_PROGRAM_DIR)\ActiproSoftware.WinUICore.Net20.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ActiproSoftware.Shared.Net20">
      <HintPath>$(GX_PROGRAM_DIR)\ActiproSoftware.Shared.Net20.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Los íconos de los botones: GeneXus los toma de un recurso compilado con Bitmaps (el del manifiesto,
       <Resource type="images">), que dotnet build no sabe generar desde un .resx para .NET Framework.
       Se arma con Windows PowerShell desde los .png de la carpeta. -->
  <PropertyGroup>
    <GxImagesResources>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)GxCodeCheck.Images.resources</GxImagesResources>
  </PropertyGroup>
  <ItemGroup>
    <GxImage Include="Review.png" />
  </ItemGroup>
  <Target Name="GxCodeCheckImages" BeforeTargets="PrepareForBuild" Inputs="@(GxImage)" Outputs="$(GxImagesResources)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Add-Type -AssemblyName System.Drawing; $w = New-Object System.Resources.ResourceWriter('$(GxImagesResources)'); foreach ($f in '@(GxImage->'%(FullPath)')'.Split(';')) { $w.AddResource([System.IO.Path]::GetFileNameWithoutExtension($f), [System.Drawing.Bitmap]::FromFile($f)) }; $w.Close()&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(GxImagesResources)" LogicalName="GxCodeCheck.Images.resources" />
    </ItemGroup>
  </Target>
</Project>
