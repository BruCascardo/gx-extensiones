<Project>
  <PropertyGroup>
    <!-- Instalación de GeneXus contra la que se compila y a la que se despliega -->
    <GX_PROGRAM_DIR Condition=" '$(GX_PROGRAM_DIR)' == '' ">C:\GeneXus\GeneXus18u15b188745</GX_PROGRAM_DIR>

    <!-- Referencias del mismo upgrade (GX18 U15) -->
    <GeneXusPackageReferenceVersion>18.15.13</GeneXusPackageReferenceVersion>
    <GeneXusSdkTargetFrameworks>net471</GeneXusSdkTargetFrameworks>

    <!-- El IDE es de 32 bits -->
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
